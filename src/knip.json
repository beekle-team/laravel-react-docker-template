{
    "$schema": "https://unpkg.com/knip@latest/schema.json",
    "entry": [
        "resources/js/app.tsx",
        "resources/js/Pages/**/*.tsx",
        "playwright.config.ts",
        "vite.config.js"
    ],
    "project": ["resources/js/**/*.{ts,tsx}", "*.config.{js,ts}"],
    "ignoreBinaries": ["php"],
    "ignore": [
        "resources/js/actions/**",
        "resources/js/routes/**",
        "resources/js/types/generated.d.ts",
        "resources/js/wayfinder/**"
    ],
    "ignoreDependencies": [
        "@inertiajs/core",
        "@laravel/vite-plugin-wayfinder",
        "@tailwindcss/forms",
        "@vitejs/plugin-react",
        "concurrently",
        "laravel-vite-plugin",
        "playwright",
        "tailwindcss"
    ]
}
