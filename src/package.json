{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "php artisan wayfinder:generate --with-form && tsc && vite build",
        "dev": "vite",
        "lint": "biome lint .",
        "format": "biome format --write .",
        "check": "biome check --apply .",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:install": "playwright install --with-deps",
        "types": "tsc --noEmit",
        "lint:js": "biome lint .",
        "lint:dead-code": "knip --no-config-hints",
        "lint:duplication": "jscpd --config jscpd.json --exit-code 1 resources/js app tests",
        "lint:architecture": "npm run lint:dead-code && npm run lint:duplication"
    },
    "devDependencies": {
        "@biomejs/biome": "^1.5.3",
        "@headlessui/react": "^2.0.0",
        "@inertiajs/react": "^2.3.0",
        "@laravel/vite-plugin-wayfinder": "^0.1.7",
        "@tailwindcss/forms": "^0.5.3",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^20.19.0",
        "@types/react": "^18.0.28",
        "@types/react-dom": "^18.0.10",
        "@vitejs/plugin-react": "^4.2.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "jscpd": "^5.0.14",
        "knip": "^6.29.0",
        "laravel-vite-plugin": "^2.0.0",
        "playwright": "^1.57.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.0.2",
        "vite": "^7.0.4"
    }
}
