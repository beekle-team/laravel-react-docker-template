includes:
    - ./phpstan-architecture-baseline.neon
    - ./vendor/larastan/larastan/extension.neon
    - ./phpstan-rules.neon

parameters:
    excludePaths:
        analyse:
            - tests/PHPStan/Fixtures
    paths:
        - app/
        - database/
        - routes/
        - tests/

    # Level 9 is the highest level
    level: 9

    ignoreErrors:
        # Pest 5 のテストクロージャは実行時に TestCase へ束縛されるが、静的解析からは
        # Pest\PendingCalls\TestCall として見える。Laravel の TestCase が
        # 実際に持つメソッドだけを列挙する（$this->psot() のような打ち間違いは検出したい）。
        -
            identifier: method.notFound
            message: '#^Call to an undefined method Pest\\PendingCalls\\TestCall::(actingAs|assertAuthenticated|assertGuest|post)\(\)#'
            paths:
                - tests/Feature
        # arch() / preset() の流暢 API も PendingCalls 経由で解決されるため同様。
        -
            identifier: method.notFound
            message: '#^Call to an undefined method Pest\\PendingCalls\\TestCall::(expect|preset)\(\)#'
            paths:
                - tests/Arch
