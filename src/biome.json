{
    "$schema": "https://biomejs.dev/schemas/1.5.3/schema.json",
    "organizeImports": {
        "enabled": true
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "a11y": {
                "noLabelWithoutControl": "off",
                "noSvgWithoutTitle": "off",
                "useAltText": "off",
                "useKeyWithClickEvents": "off"
            }
        }
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "files": {
        "ignore": [
            "node_modules",
            "public",
            "vendor",
            "storage",
            "bootstrap/cache",
            "public/build",
            "test-results",
            "playwright-report",
            "*.blade.php",
            "resources/js/actions",
            "resources/js/routes",
            "resources/js/types/generated.d.ts",
            "resources/js/wayfinder"
        ]
    }
}
