{
    "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
    "assist": { "actions": { "source": { "organizeImports": "on" } } },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "a11y": {
                "noLabelWithoutControl": "off",
                "noStaticElementInteractions": "off",
                "noSvgWithoutTitle": "off",
                "useAltText": "off",
                "useKeyWithClickEvents": "off"
            },
            "suspicious": {
                "noUnknownAtRules": {
                    "level": "error",
                    "options": {
                        "ignore": ["tailwind", "apply", "layer", "variants", "screen", "config"]
                    }
                }
            }
        }
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "files": {
        "includes": [
            "**",
            "!**/node_modules",
            "!**/public",
            "!**/vendor",
            "!**/storage",
            "!**/bootstrap/cache",
            "!**/public/build",
            "!**/*.blade.php",
            "!**/test-results",
            "!**/playwright-report",
            "!**/package-lock.json",
            "!**/composer.lock",
            "!**/resources/js/actions",
            "!**/resources/js/routes",
            "!**/resources/js/types/generated.d.ts",
            "!**/resources/js/wayfinder"
        ]
    }
}
